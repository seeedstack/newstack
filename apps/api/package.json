{
  "name": "@newstack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp src/features/auth/common-passwords.txt dist/features/auth/common-passwords.txt",
    "start": "node dist/server.js",
    "test": "node --env-file-if-exists=.env ./node_modules/.bin/vitest run",
    "billing:reconcile": "tsx src/features/billing/reconcile.ts",
    "billing:provision-plans": "tsx src/features/billing/provision-plans.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
